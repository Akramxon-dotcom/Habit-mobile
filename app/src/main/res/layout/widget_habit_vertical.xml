<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_glass_pill"
        android:text="⚡ FAOL"
        android:textColor="#D9A954"
        android:textSize="9.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_task_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:text="Hozirgi vazifa"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_task_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="08:00 – 09:30"
        android:textColor="#9E9EB8"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_time_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="25 daqiqa"
        android:textColor="#D9A954"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_btn_done"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_btn_gold"
        android:text="✅ Bajardim"
        android:textAllCaps="false"
        android:textColor="#12162A"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
